# Google Gemini API key (get one free at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=AIza...

# Optional: override the model used for extraction (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Alternative to GOOGLE_API_KEY: use Vertex AI (same GCP project as your service
# account below) instead of a separate Gemini API key.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Google Sheet to append rows to (the ID in the sheet's URL)
SHEET_ID=1R_qUspQW-elqBi3UGEXt5gNLuy2qkVrlyRnhkaEveKI
# Tab/sheet name inside the spreadsheet
SHEET_NAME=Sheet1

# Google service account credentials, used to write to the Sheet — set ONE of these:
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Optional: port to run the app on
PORT=5000
